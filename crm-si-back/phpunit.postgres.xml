<?xml version="1.0" encoding="UTF-8"?>
<!--
    Suite aparte para tests que necesitan Postgres real. SQLite (phpunit.xml)
    no distingue timestamp de timestamptz y por eso no puede detectar el bug
    de timezone que motivo esta suite.

    Corre contra pgsql_testing (ver config/database.php), la base
    si_crm_test en el mismo Postgres del docker compose de dev. Uso:
    php artisan test -c phpunit.postgres.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap-postgres.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Postgres">
            <directory>tests/Feature</directory>
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <groups>
        <include>
            <group>requires-postgres</group>
        </include>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql_testing" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
