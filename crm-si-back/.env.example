APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

AI_MAX_HISTORY=20
AI_OPENAI_TRANSLATION_MODEL=gpt-5-mini
AI_CLAUDE_TRANSLATION_MODEL=claude-haiku-4-5-20251001

# Días de retención de los registros de webhook_deliveries antes de purgarlos.
WEBHOOK_DELIVERY_RETENTION_DAYS=30
# Tope de contactos por request al import bulk asíncrono (POST .../bulk).
WEBHOOK_BULK_MAX_CONTACTS=5000
# Tope en bytes del body del import bulk (2MB por defecto).
WEBHOOK_BULK_MAX_BODY_BYTES=2097152
# Debe superar el timeout del job bulk (300s) para evitar redelivery concurrente.
REDIS_QUEUE_RETRY_AFTER=330

# OAuth Google Calendar (por usuario). Crear en Google Cloud Console:
# OAuth Client ID tipo "Web application", con GOOGLE_CALENDAR_REDIRECT_URI
# como Authorized redirect URI (debe apuntar a GET /api/google-calendar/callback).
# Requiere publicar la app en modo Production para evitar que los refresh
# tokens expiren a los 7 días (límite del modo Testing).

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/api/google-calendar/callback"

# WhatsApp central de alertas SI CRM (derivaciones a humano y verificación)
SI_CRM_ALERTS_ENABLED=false
SI_CRM_ALERTS_WA_PHONE_NUMBER_ID=
SI_CRM_ALERTS_WA_WABA_ID=
SI_CRM_ALERTS_WA_ACCESS_TOKEN=
SI_CRM_ALERTS_WA_APP_SECRET=
SI_CRM_ALERTS_WA_VERIFY_TOKEN=
SI_CRM_ALERTS_WA_DISPLAY_NUMBER=
SI_CRM_ALERTS_CHANNEL_FALLBACK_ENABLED=false
SI_CRM_ALERTS_VERIFICATION_TEMPLATE_ES=si_crm_alerts_verification_es
SI_CRM_ALERTS_VERIFICATION_TEMPLATE_EN=si_crm_alerts_verification_en
SI_CRM_ALERTS_HANDOFF_TEMPLATE_ES=si_crm_alerts_handoff_es
SI_CRM_ALERTS_HANDOFF_TEMPLATE_EN=si_crm_alerts_handoff_en
